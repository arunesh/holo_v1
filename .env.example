# Holodeck configuration. Copy to .env and fill in.

# Required for the AI tutor + pod generation (already set in this environment).
ANTHROPIC_API_KEY=

# Optional. If set, voice uses ElevenLabs; if empty, the browser Web Speech API is used.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Sign-in. The Google OAuth *Web* client ID whose tokens the server accepts; add your
# site's origin under "Authorized JavaScript origins" in Google Cloud.
HOLODECK_GOOGLE_CLIENT_ID=
# Signs our session tokens. Set a long random value (e.g. `openssl rand -hex 32`);
# if empty, a random one is used and everyone is signed out on restart.
HOLODECK_SESSION_SECRET=
# Session token lifetime in seconds; open tabs renew it before it runs out.
HOLODECK_SESSION_TTL=3600
# true lets people enter without Google (local development, public demos).
HOLODECK_ALLOW_GUEST=false

# Optional model overrides.
HOLODECK_CLAUDE_MODEL=claude-opus-4-8
HOLODECK_GENERATOR_MODEL=claude-opus-4-8
HOLODECK_GPT2_MODEL=gpt2
